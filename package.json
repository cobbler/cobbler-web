{
  "name": "cobbler",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --no-watch --coverage",
    "lint": "ng lint",
    "doc": "./node_modules/.bin/compodoc -p tsconfig.json -a screenshots -n \"Cobbler Frontend Docs\" --includes docs-additonal",
    "doc:serve": "./node_modules/.bin/compodoc -p tsconfig.json -a screenshots -n \"Cobbler Frontend Docs\" --includes docs-additonal -s",
    "e2e": "ng e2e",
    "e2e:ci": "ng e2e --configuration=production",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.20",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^21.2.20",
    "@angular/router": "^22.1.4",
    "rxjs": "^7.4.0",
    "stream": "0.0.2",
    "timers": "^0.1.1",
    "tslib": "^2.6.3",
    "xmlbuilder2": "^2.4.1",
    "xng-breadcrumb": "^15.0.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.22",
    "@angular-eslint/builder": "22.2.0",
    "@angular-eslint/eslint-plugin": "22.2.0",
    "@angular-eslint/eslint-plugin-template": "22.2.0",
    "@angular-eslint/schematics": "22.2.0",
    "@angular-eslint/template-parser": "22.2.0",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@angular/localize": "^22.1.4",
    "@compodoc/compodoc": "^1.1.25",
    "@playwright/test": "1.62.1",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^20.17.11",
    "@types/xmlrpc": "^1.3.10",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitest/coverage-v8": "^4.1.9",
    "codecov": "^3.8.3",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.1.1",
    "playwright-ng-schematics": "^21.1.1",
    "prettier": "3.3.3",
    "prettier-eslint": "^16.3.0",
    "semantic-release": "^25.0.8",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9",
    "xmlrpc": "^1.3.2"
  }
}
